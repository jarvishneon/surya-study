name: Generate Worksheet Manifest

on:
  push:
    paths:
      - "Worksheets/**"
      - "worksheets.json"
      - ".github/workflows/generate-worksheets.yml"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: worksheet-manifest
  cancel-in-progress: false

jobs:
  generate:
    # Avoid running again for the bot's own manifest commit.
    if: github.actor != 'github-actions[bot]'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Generate worksheets.json (keep old images first)
        shell: bash
        run: |
          python3 <<'PY'
          import json
          import re
          import subprocess
          from pathlib import PurePosixPath

          IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".gif"}

          def natural_key(value):
              return [
                  int(part) if part.isdigit() else part.lower()
                  for part in re.split(r"(\d+)", value)
              ]

          # Keep every existing manifest entry and its current order.
          try:
              with open("worksheets.json", "r", encoding="utf-8") as file:
                  manifest = json.load(file)
          except (FileNotFoundError, json.JSONDecodeError):
              manifest = {}

          manifest.setdefault("competitive", {})
          manifest.setdefault("board", {})

          for subject in ["English", "Math", "Hindi", "Reasoning", "GS"]:
              manifest["competitive"].setdefault(subject, [])

          for class_name in ["9th-class", "10th-class"]:
              manifest["board"].setdefault(class_name, {})
              for subject in ["Hindi", "English", "Math", "Science", "Geography"]:
                  manifest["board"][class_name].setdefault(subject, [])

          tracked = subprocess.check_output(
              ["git", "ls-files", "-z"], text=True
          ).split("\0")

          # Oldest image additions come first; newly committed images are appended.
          history = subprocess.check_output(
              [
                  "git", "log", "--reverse", "--diff-filter=A",
                  "--format=", "--name-only", "--", "Worksheets/"
              ],
              text=True
          ).splitlines()

          add_order = {}
          for item in history:
              item = item.strip()
              if item and item not in add_order:
                  add_order[item] = len(add_order)

          def get_target(raw_path):
              path = PurePosixPath(raw_path)
              parts = path.parts
              if len(parts) < 4 or parts[0].lower() != "worksheets":
                  return None
              if path.suffix.lower() not in IMAGE_EXTENSIONS:
                  return None

              section = parts[1].lower()
              if section == "competitive" and len(parts) == 4:
                  return manifest["competitive"].setdefault(parts[2], [])
              if section == "board" and len(parts) == 5:
                  return manifest["board"].setdefault(parts[2], {}).setdefault(parts[3], [])
              return None

          image_paths = []
          for raw_path in tracked:
              if raw_path and get_target(raw_path) is not None:
                  image_paths.append(raw_path)

          image_paths.sort(
              key=lambda item: (
                  add_order.get(item, 10**12),
                  natural_key(PurePosixPath(item).name),
                  item.lower()
              )
          )

          # Append only missing paths. Do not reorder or delete old entries.
          for raw_path in image_paths:
              target = get_target(raw_path)
              if raw_path not in target:
                  target.append(raw_path)

          with open("worksheets.json", "w", encoding="utf-8") as file:
              json.dump(manifest, file, ensure_ascii=False, indent=2)
              file.write("\n")

          print("Updated manifest: existing images retained; new images appended.")
          PY

      - name: Commit updated manifest
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add worksheets.json
          if git diff --cached --quiet; then
            echo "worksheets.json is already up to date."
            exit 0
          fi
          git commit -m "chore: append new worksheet images"
          git push
